@base_url = http://localhost:8080/api/trips
@auth_header = {"id": 1, "email": "admin@travel.com"}

# View trips
# ======================================
### list all trips happy path
GET {{base_url}} HTTP/1.1
Authorization: {{auth_header}}

### list all trips sad path

GET {{base_url}} HTTP/1.1

# Create a trip
# =======================================
### create trip happy path (201)
POST {{base_url}} HTTP/1.1
Content-Type: application/json
Authorization: {{auth_header}}

{
  "country": "USA",
  "city": "Texas",
  "startDate": "2026-12-10",
  "endDate": "2026-13-12",
  "notes": "Food + museums"
}

### create trip no auth (401/403)
POST {{base_url}} HTTP/1.1
Content-Type: application/json
# Authorization: {{auth_header}}

{
  "country": "USA",
  "city": "Chicago",
  "startDate": "2026-03-10",
  "endDate": "2026-03-12",
  "notes": "Food + museums"
}

### create trip invalid date range (400)
POST {{base_url}} HTTP/1.1
Content-Type: application/json
Authorization: {{auth_header}}

{
  "country": "USA",
  "city": "Chicago",
  "startDate": "2026-03-12",
  "endDate": "2026-03-10",
  "notes": "End before start"
}

# Update
# =========================================

### update trip happy path (204/200)
PUT {{base_url}}/1 HTTP/1.1
Content-Type: application/json
Authorization: {{auth_header}}

{
  "tripId": 1,
  "country": "USA",
  "city": "Chicago",
  "startDate": "2026-03-10",
  "endDate": "2026-03-13",
  "notes": "Updated notes"
}

### update trip no auth (401/403)
PUT {{base_url}}/1 HTTP/1.1
Content-Type: application/json

{
  "tripId": 1,
  "country": "USA",
  "city": "Chicago",
  "startDate": "2026-03-10",
  "endDate": "2026-03-13",
  "notes": "Updated notes"
}

### update trip wrong owner (403)
PUT {{base_url}}/1 HTTP/1.1
Content-Type: application/json
Authorization: {"id": 2, "email": "b@b.com"}

{
  "tripId": 1,
  "country": "USA",
  "city": "Chicago",
  "startDate": "2026-03-10",
  "endDate": "2026-03-13",
  "notes": "Updated notes"
}

### update trip not found (404)
PUT {{base_url}}/9999 HTTP/1.1
Content-Type: application/json
Authorization: {{auth_header}}

{
  "tripId": 9999,
  "country": "USA",
  "city": "Chicago",
  "startDate": "2026-03-10",
  "endDate": "2026-03-13",
  "notes": "Not found"
}

### update trip id mismatch (409)
PUT {{base_url}}/1 HTTP/1.1
Content-Type: application/json
Authorization: {{auth_header}}

{
  "tripId": 2,
  "country": "USA",
  "city": "Chicago",
  "startDate": "2026-03-10",
  "endDate": "2026-03-13",
  "notes": "TripId mismatch"
}


### DELETE

### delete trip happy path (204)
DELETE {{base_url}}/1 HTTP/1.1
Authorization: {{auth_header}}

### delete trip no auth (401/403)
DELETE {{base_url}}/1 HTTP/1.1\

### delete trip wrong owner (403)
DELETE {{base_url}}/1 HTTP/1.1
Authorization: {"id": 2, "email": "a@a.com"}

### delete trip not found (404)
DELETE {{base_url}}/9999 HTTP/1.1
Authorization: {{auth_header}}
