@base_url = http://localhost:8080/api/trips
@auth_header = {"userId":1,"email":"admin@travel.com"}|-2120907375

# View trips
# ======================================
### list all public trips happy path

GET {{base_url}}/templates HTTP/1.1

### find trip by id happy path

GET {{base_url}}/1 HTTP/1.1

### find trip by id with details happy path

GET {{base_url}}/1/details HTTP/1.1

# Create a trip
# =======================================
### create trip unauthorized sad path
POST http://localhost:8080/api/trips
Content-Type: application/json

{
  "country": "Japan",
  "city": "Tokyo",
  "startDate": "2026-03-10",
  "endDate": "2026-03-12",
  "notes": "No auth header test",
  "days": []
}

### create a trip happy path

POST http://localhost:8080/api/trips
Content-Type: application/json
Authorization: {{auth_header}}

{
  "country": "Japan",
  "city": "Tokyo",
  "startDate": "2026-03-10",
  "endDate": "2026-03-12",
  "notes": "Service test trip",
  "days": [
    {
      "dayDate": "2026-03-10",
      "dayNotes": "Day One Notes",
      "activities": [
        {
          "title": "Check-in",
          "description": null,
          "location": "Hotel",
          "startTime": "15:00:00",
          "endTime": "16:00:00"
        },
        {
          "title": "Dinner",
          "description": null,
          "location": "Shinjuku",
          "startTime": "19:00:00",
          "endTime": "21:00:00"
        }
      ]
    },
    {
      "dayDate": "2026-03-11",
      "dayNotes": "Explore",
      "activities": []
    }
  ]
}

### create trip with null times:

POST http://localhost:8080/api/trips
Content-Type: application/json
Authorization: {{auth_header}}

{
  "country": "USA",
  "city": "Chicago",
  "startDate": "2026-04-01",
  "endDate": "2026-04-03",
  "notes": "Null time test",
  "days": [
    {
      "dayDate": "2026-04-01",
      "dayNotes": "No times today",
      "activities": [
        {
          "title": "Walk around",
          "description": null,
          "location": "Downtown",
          "startTime": null,
          "endTime": null
        }
      ]
    }
  ]
}

### create trip with missing fields

POST http://localhost:8080/api/trips
Content-Type: application/json
Authorization: {{auth_header}}

{
  "country": null,
  "city": "Tokyo",
  "startDate": "2026-03-10",
  "endDate": "2026-03-12",
  "notes": "Bad country test",
  "days": []
}

# View past trips
# ================================

### view my upcoming trips - unauthorized
GET {{base_url}}/mine/upcoming

### view my upcoming trips - happy path
GET {{base_url}}/mine/upcoming
Authorization: {{auth_header}}

### view my past trips - happy path
GET {{base_url}}/mine/past
Authorization: {{auth_header}}


# Update
# =========================================

### update trip happy path (204/200)
PUT {{base_url}}/1 HTTP/1.1
Content-Type: application/json
Authorization: {{auth_header}}

{
  "tripId": 1,
  "country": "USA",
  "city": "Chicago",
  "startDate": "2026-03-10",
  "endDate": "2026-03-13",
  "notes": "Updated notes"
}

### update trip no auth (401/403)
PUT {{base_url}}/1 HTTP/1.1
Content-Type: application/json

{
  "tripId": 1,
  "country": "USA",
  "city": "Chicago",
  "startDate": "2026-03-10",
  "endDate": "2026-03-13",
  "notes": "Updated notes"
}

### update trip wrong owner (403)
PUT {{base_url}}/1 HTTP/1.1
Content-Type: application/json
Authorization: {"id": 2, "email": "b@b.com"}

{
  "tripId": 1,
  "country": "USA",
  "city": "Chicago",
  "startDate": "2026-03-10",
  "endDate": "2026-03-13", 
  "notes": "Updated notes"
}

### update trip not found (404)
PUT {{base_url}}/9999 HTTP/1.1
Content-Type: application/json
Authorization: {{auth_header}}

{
  "tripId": 9999,
  "country": "USA",
  "city": "Chicago",
  "startDate": "2026-03-10",
  "endDate": "2026-03-13",
  "notes": "Not found"
}

### update trip id mismatch (409)
PUT {{base_url}}/1 HTTP/1.1
Content-Type: application/json
Authorization: {{auth_header}}

{
  "tripId": 2,
  "country": "USA",
  "city": "Chicago",
  "startDate": "2026-03-10",
  "endDate": "2026-03-13",
  "notes": "TripId mismatch"
}


### DELETE

### delete trip happy path
DELETE http://localhost:8080/api/trips/2
Authorization: {{auth_header}}

### delete trip no auth
DELETE http://localhost:8080/api/trips/1

### delete trip not found
DELETE http://localhost:8080/api/trips/999
Authorization: {{auth_header}}

